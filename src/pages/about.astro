---
import Base from '../layouts/Base.astro';
import { getSite, href } from '../lib/content';
import { clip, aboutJsonLd } from '../lib/seo';
const site = await getSite();
---

<Base title={`About ${site.ownerName || 'Huzzah'}, production designer`} description={clip(site.bio)} jsonLd={aboutJsonLd(site)}>
  <div class="wrap page">
    <h1>About<span style="color:var(--accent)">.</span></h1>
    <p>{site.bio}</p>
    <p>
      <a href={href('/services')} style="color:var(--accent)">Services →</a>
      &nbsp;&nbsp;
      <a href={href('/design/awards')} style="color:var(--accent)">Awards →</a>
    </p>
    <h2 style="margin-top:3rem;font-size:1.5rem">Clients</h2>
    <ul class="clients">
      {site.clients.map((c) => <li>{c}</li>)}
    </ul>
    <p style="font-size:.85rem;color:var(--muted);margin-top:1rem">A partial list.</p>
  </div>
</Base>
