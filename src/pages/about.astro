---
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/content';
const site = await getSite();
---

<Base title="About">
  <div class="wrap page">
    <h1>About<span style="color:var(--accent)">.</span></h1>
    <p>{site.bio}</p>
    <p><a href="/services" style="color:var(--accent)">Services →</a></p>
    <h2 style="margin-top:3rem;font-size:1.5rem">Clients</h2>
    <ul class="clients">
      {site.clients.map((c) => <li>{c}</li>)}
    </ul>
    <p style="font-size:.85rem;color:var(--muted);margin-top:1rem">A partial list.</p>
  </div>
</Base>
