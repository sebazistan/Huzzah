---
import Base from '../layouts/Base.astro';
import { getServices } from '../lib/content';
const items = await getServices();
---

<Base title="Services">
  <div class="wrap page" style="max-width:980px">
    <h1>Services<span style="color:var(--accent)">.</span></h1>
    {items.map((s) => (
      <section class="service reveal">
        <h2>{s.title}</h2>
        <div><p>{s.text}</p><a href={s.link}>Explore {s.title} →</a></div>
      </section>
    ))}
  </div>
</Base>
