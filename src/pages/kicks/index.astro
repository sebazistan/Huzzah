---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, getSite } from '../../lib/content';

const site = await getSite();
const projects = await getProjects('kicks');
---

<Base title="For Kicks: personal projects" section="kicks" description={`${site.kicksIntro} Personal projects by Huzzah in Toronto, including Toilet Town.`}>
  <section class="wrap hero">
    <h1>For Kicks<em>.</em></h1>
    <p>{site.kicksIntro}</p>
  </section>
  <div class="wrap">
    {projects.length === 0 && <p style="color:var(--muted)">Projects coming soon.</p>}
    <div class="grid">
      {projects.map((p, i) => <ProjectCard project={p} base="/kicks" index={i} />)}
    </div>
  </div>
</Base>
