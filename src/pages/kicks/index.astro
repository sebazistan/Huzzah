---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects('kicks');
---

<Base title="For Kicks" section="kicks" description="Not everything I do is for money.">
  <section class="wrap hero">
    <h1>For Kicks<em>.</em></h1>
    <p>Not everything I do is for money.</p>
  </section>
  <div class="wrap">
    {projects.length === 0 && <p style="color:var(--muted)">Projects coming soon.</p>}
    <div class="grid">
      {projects.map((p, i) => <ProjectCard project={p} base="/kicks" index={i} />)}
    </div>
  </div>
</Base>
