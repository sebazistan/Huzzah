---
import Base from '../../../layouts/Base.astro';
import { getToiletTown } from '../../../lib/content';
import { ttNav, ttBrand } from '../../../lib/toilet-town';
const tt = await getToiletTown();
---

<Base title="Toilet Town Shop" section="kicks" nav={ttNav} brand={ttBrand}>
  <div class="wrap page">
    <h1>Shop<span style="color:var(--accent)">.</span></h1>
    <p>{tt.shopText}</p>
    <p style="color:var(--muted)">{tt.shopNote}</p>
  </div>
</Base>
