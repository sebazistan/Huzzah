---
import ProjectPage from '../../components/ProjectPage.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  // Toilet Town is a mini-site with its own pages under /kicks/toilet-town/
  const projects = (await getProjects('kicks')).filter((p) => p.slug !== 'toilet-town');
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---

<ProjectPage project={project} section="kicks" backHref="/kicks" backLabel="For Kicks" />
