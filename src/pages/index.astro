---
import Base from '../layouts/Base.astro';
import { href } from '../lib/content';
---

<Base section="home" description="Huzzah: production design, pre-vis, props and VFX for film, television and the web.">
  <div class="split-brand">HUZZAH</div>
  <div class="split">
    <a class="split-pane design" href={href('/design')}>
      <span class="kicker">Production Design · Pre-Vis · Props</span>
      <h2>Design</h2>
      <p>Sets, worlds and props for film, television and commercials.</p>
      <span class="arrow">→</span>
    </a>
    <a class="split-pane vfx" href={href('/vfx')}>
      <span class="kicker">Award-winning</span>
      <h2>VFX</h2>
      <p>Visual effects for film, television and the web.</p>
      <span class="arrow">→</span>
    </a>
  </div>
</Base>
