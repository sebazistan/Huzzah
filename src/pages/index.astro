---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { getSite, getProjects, getCategories, getContactForms, getAwards, href } from '../lib/content';
import { siteJsonLd } from '../lib/seo';

const site = await getSite();
const winners = [...(await getAwards('design')), ...(await getAwards('vfx'))]
  .filter((a) => a.result === 'Winner')
  .map((a) => `${a.award}: ${a.detail}`);
const jsonLd = siteJsonLd(site, winners, site.shareImage ? href(site.shareImage) : undefined);
const cats = await getCategories();
const tiles = cats.filter((c) => c.section === 'design' || c.section === 'kicks');
const featured = (await getProjects('design')).filter((p) => p.featured);
const form = (await getContactForms()).find((f) => f.slug === 'design');
const catHref = (c: (typeof cats)[number]) => href(c.section === 'kicks' ? '/kicks' : `/design/category/${c.slug}`);
---

<Base rawTitle={site.homeTitle || 'Huzzah'} description={site.homeDescription || site.tagline} jsonLd={jsonLd}>
  <section class="wrap hero">
    <h1>{site.heroHeading.replace(/\.$/, '')}<em>.</em></h1>
    <p>{site.tagline}</p>
  </section>

  <div class="wrap">
    <div class="cats">
      {tiles.map((c, i) => (
        <a class="cat reveal" href={catHref(c)} style={`--d:${i * 70}ms`}>
          {c.cover && <img src={href(c.cover)} alt="" loading="lazy" />}
          <div><h3>{c.name}</h3><p>{c.blurb}</p></div>
        </a>
      ))}
    </div>

    <div class="section-head"><h2>Featured work</h2></div>
    <div class="grid">
      {featured.map((p, i) => <ProjectCard project={p} base="/design" index={i} />)}
    </div>

    <div class="section-head"><h2>Who am I?</h2><a href={href('/about')}>Read more →</a></div>
    <p style="max-width:62ch;font-size:1.15rem;color:#d4d3cf">{site.bio}</p>

    {form && (
      <>
        <div class="section-head" id="contact"><h2>{form.heading}</h2><a href={href('/contact/design')}>Full contact page →</a></div>
        <ContactForm form={form} />
      </>
    )}
  </div>
</Base>
