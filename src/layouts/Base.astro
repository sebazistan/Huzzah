---
import '../styles/global.css';
import '../styles/toilet-town.css';
import '../styles/lightbox.css';
import { getSite, href } from '../lib/content';
import { absUrl } from '../lib/seo';

interface Props {
  title?: string;
  /** Use instead of "title | Huzzah" when the whole title is already written (the home page). */
  rawTitle?: string;
  description?: string;
  section?: 'home' | 'design' | 'vfx' | 'kicks' | 'toilet';
  image?: string;
  /** Structured data for search engines (see src/lib/seo.ts). */
  jsonLd?: unknown;
  /** Keep this page out of search results (the 404 page). */
  noindex?: boolean;
  /** Override the section's menu (used by mini-sites like Toilet Town). */
  nav?: { href: string; label: string }[];
  brand?: { label: string; sub: string; href: string };
}
const { title, rawTitle, description: descriptionProp, section = 'design', image, jsonLd, noindex, nav: navOverride, brand } = Astro.props;
const site = await getSite();
const description = descriptionProp || site.homeDescription || 'Huzzah: production design, pre-vis, props and VFX.';
const fullTitle = rawTitle ?? (title ? `${title} | Huzzah` : 'Huzzah');

// Share preview: the page's own photo if it has one, otherwise the site's default picture
const shareImage = absUrl(image || (site.shareImage ? href(site.shareImage) : ''));
const canonical = absUrl(Astro.url.pathname);

const navs = {
  home: [],
  design: [
    { href: '/', label: 'Work' },
    { href: '/design/category/production-design', label: 'Production Design' },
    { href: '/design/category/pre-vis', label: 'Pre-Vis' },
    { href: '/design/category/props', label: 'Props' },
    { href: '/services', label: 'Services' },
    { href: '/about', label: 'About' },
    { href: '/contact/design', label: 'Contact' },
  ],
  vfx: [
    { href: '/vfx', label: 'Work' },
    { href: '/vfx/about', label: 'About' },
    { href: '/vfx/awards', label: 'Awards' },
    { href: '/contact/vfx', label: 'Contact' },
  ],
  kicks: [
    { href: '/kicks', label: 'For Kicks' },
    { href: '/contact/kicks', label: 'Contact' },
    { href: '/', label: '← Home' },
  ],
  toilet: [], // Toilet Town always passes its own menu
};
const nav = navOverride ?? navs[section];
const norm = (p: string) => p.replace(/\/$/, '') || '/';
const path = norm(Astro.url.pathname);
const logo = brand ?? {
  label: 'HUZZAH',
  sub: section === 'vfx' ? 'VFX' : section === 'kicks' ? 'FOR KICKS' : '',
  href: section === 'vfx' ? '/vfx' : '/',
};
---

<!doctype html>
<html lang="en" data-section={section}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:site_name" content="Huzzah" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta property="og:image:alt" content={fullTitle} />}

    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {shareImage && <meta name="twitter:image" content={shareImage} />}

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
    <link rel="icon" type="image/png" sizes="32x32" href={href('/favicon-32.png')} />
    <link rel="icon" href={href('/favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    {section === 'toilet' && (
      <link
        href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700&display=swap"
        rel="stylesheet"
      />
    )}
  </head>
  <body>
    {section !== 'home' && (
      <header class="header">
        <a class="logo" href={href(logo.href)} aria-label={`${logo.label} home`}>
          {logo.label}{logo.sub && <span class="logo-sub">{logo.sub}</span>}
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => (
            <a href={href(n.href)} aria-current={path === norm(href(n.href)) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </header>
    )}

    <main>
      <slot />
    </main>

    {section !== 'home' && (
      <footer class="footer">
        <div class="footer-inner">
          <span>© {new Date().getFullYear()} {site.footerText}</span>
          <span class="footer-links">
            {site.instagram && <a href={site.instagram} rel="noopener">Instagram</a>}
            {site.imdb && <a href={site.imdb} rel="noopener">IMDb</a>}
            {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
          </span>
        </div>
      </footer>
    )}

    <script>
      import '../scripts/lightbox';
    </script>
    <script>
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }),
        { threshold: 0.12 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
