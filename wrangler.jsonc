{
  // Cloudflare: publish the static Astro build (dist/) as the site.
  // _redirects (generated at build time) is picked up automatically.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huzzah",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    // The editor pages are served by the Worker, not by static files. Without this,
    // browsers get the 404 page for them before the Worker runs.
    "run_worker_first": ["/keystatic", "/keystatic/*", "/api/keystatic/*"]
  }
}
